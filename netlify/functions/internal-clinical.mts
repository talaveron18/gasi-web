import type { Config, Context } from "@netlify/functions";
import { getDatabase } from "@netlify/database";
import crypto from "node:crypto";
import bcrypt from "bcryptjs";

const env=(name:string)=>typeof Netlify!=="undefined"?(Netlify.env.get(name)||""):(process.env[name]||"");
const MASTER=()=>env("GASI_MASTER_ACTOR_ID")||"GASI-MASTER-01";
const json=(body:unknown,status=200,extraHeaders:Record<string,string>={})=>new Response(JSON.stringify(body),{status,headers:{"content-type":"application/json","cache-control":"no-store",...extraHeaders}});
const b64=(v:Buffer|string)=>Buffer.from(v).toString("base64url");
const bearer=(req:Request)=>{const value=req.headers.get("authorization")||"";return value.startsWith("Bearer ")?value.slice(7):"";};
const profile=(w:any)=>({id:w.id,role:w.role,display_name:w.display_name,centers:w.centers||[],operational_state:w.active?"ACTIVE":"REVOKED",delegated_privileges:w.delegated_privileges||[]});
const has=(w:any,p:string)=>w.id===MASTER()||(w.delegated_privileges||[]).includes(p);
const required=(v:unknown,name:string)=>{const s=String(v||"").trim();if(!s)throw new Error(`${name}_required`);if(s.length>160)throw new Error(`${name}_too_long`);return s;};
function secret(){const value=env("GASI_INTERNAL_SESSION_SECRET");if(Buffer.byteLength(value)<32)throw new Error("session_secret_not_configured");return value;}
const tokenDigest=(value:string)=>crypto.createHash("sha256").update(value).digest("hex");
const KIOSK_COOKIE="gasi_kiosk";
function cookieValue(req:Request,name:string){const raw=req.headers.get("cookie")||"";for(const part of raw.split(";")){const [k,...rest]=part.trim().split("=");if(k===name)return decodeURIComponent(rest.join("="));}return "";}
function signKiosk(device:any){const now=Math.floor(Date.now()/1000),payload={did:device.id,av:Number(device.auth_version),iat:now,exp:now+180*24*60*60};const encoded=b64(JSON.stringify(payload));const sig=crypto.createHmac("sha256",secret()).update("kiosk:"+encoded).digest("base64url");return `v1.${encoded}.${sig}`;}
function decodeKiosk(value:string){const [version,encoded,supplied]=String(value||"").split(".");if(version!=="v1"||!encoded||!supplied)throw new Error("kiosk_required");const expected=crypto.createHmac("sha256",secret()).update("kiosk:"+encoded).digest("base64url");if(expected.length!==supplied.length||!crypto.timingSafeEqual(Buffer.from(expected),Buffer.from(supplied)))throw new Error("kiosk_required");const p=JSON.parse(Buffer.from(encoded,"base64url").toString("utf8"));if(!p.did||!p.exp||!p.av||Date.now()>=Number(p.exp)*1000)throw new Error("kiosk_required");return p;}
function sign(payload:any){const encoded=b64(JSON.stringify(payload));const sig=crypto.createHmac("sha256",secret()).update(encoded).digest("base64url");return `v1.${encoded}.${sig}`;}
function decode(token:string){const [version,encoded,supplied]=token.split(".");if(version!=="v1"||!encoded||!supplied)throw new Error("invalid_session_token");const expected=crypto.createHmac("sha256",secret()).update(encoded).digest("base64url");if(expected.length!==supplied.length||!crypto.timingSafeEqual(Buffer.from(expected),Buffer.from(supplied)))throw new Error("invalid_session_token");const p=JSON.parse(Buffer.from(encoded,"base64url").toString("utf8"));if(!p.sub||!p.exp||!p.av||Date.now()>=Number(p.exp)*1000)throw new Error("session_expired_or_revoked");return p;}
async function actor(req:Request,db:any){const token=bearer(req);if(!token)throw new Error("missing_session");const p=decode(token);const rows=await db.sql`SELECT id,role,display_name,centers,active,auth_version,delegated_privileges FROM internal_clinical_workers WHERE id=${String(p.sub)} LIMIT 1`;const w=rows[0];if(!w||!w.active||Number(w.auth_version)!==Number(p.av))throw new Error("session_expired_or_revoked");return w;}
const FORBIDDEN_AUDIT_KEYS=new Set(["patient_ref","patientref","summary","text","replacement_text","previous_text","password","password_hash","token","authorization","clinical_note","note","diagnosis","symptoms"]);
function auditMetadata(metadata:any){const out:any={};for(const [raw,value] of Object.entries(metadata||{})){const key=String(raw).trim();if(!key||FORBIDDEN_AUDIT_KEYS.has(key.toLowerCase())||value!==null&&!["string","number","boolean"].includes(typeof value))throw new Error("audit_metadata_forbidden");out[key]=value;}return out;}
function canonical(value:any):string{if(value===null||typeof value!=="object")return JSON.stringify(value);if(Array.isArray(value))return "["+value.map(canonical).join(",")+"]";return "{"+Object.keys(value).sort().map(k=>JSON.stringify(k)+":"+canonical(value[k])).join(",")+"}";}
async function appendAudit(client:any,w:any,action:string,metadata:any={}){await client.query("SELECT pg_advisory_xact_lock($1)",[74627411]);const last=await client.query("SELECT event_hash FROM internal_clinical_audit ORDER BY seq DESC LIMIT 1");const previous=last.rows[0]?.event_hash||"0".repeat(64);const at=new Date().toISOString();const safe=auditMetadata(metadata),episodeId=typeof safe.episode_id==="string"?safe.episode_id:null;if(Object.prototype.hasOwnProperty.call(safe,"episode_id"))delete safe.episode_id;const payload={at,actor_id:w.id,actor_role:w.role,action,episode_id:episodeId,metadata:safe};const hash=crypto.createHash("sha256").update(previous+":"+canonical(payload)).digest("hex");await client.query("INSERT INTO internal_clinical_audit(at,actor_id,actor_role,action,episode_id,metadata,previous_hash,event_hash) VALUES($1,$2,$3,$4,$5,$6,$7,$8)",[at,w.id,w.role,action,episodeId,safe,previous,hash]);}
async function audit(db:any,w:any,action:string,metadata:any={}){const client=await db.pool.connect();try{await client.query("BEGIN");await appendAudit(client,w,action,metadata);await client.query("COMMIT");}catch(e){await client.query("ROLLBACK");throw e;}finally{client.release();}}
async function auditedMutation<T>(db:any,w:any,action:string,metadata:any,fn:(client:any)=>Promise<T>){const client=await db.pool.connect();try{await client.query("BEGIN");const result=await fn(client);await appendAudit(client,w,action,typeof metadata==="function"?metadata(result):metadata);await client.query("COMMIT");return result;}catch(e){await client.query("ROLLBACK");throw e;}finally{client.release();}}
async function verifyPassword(password:string,stored:string){if(!/^\$2[aby]\$/.test(stored))return false;return bcrypt.compare(password,stored);}
const disciplineFor=(role:string)=>role==="psychologist"?"psychology":role==="physiotherapist"?"physiotherapy":"nursing";
const canRead=(w:any,e:any)=>w.role==="admin"||(Array.isArray(w.centers)&&w.centers.includes(e.center));
const canWrite=(w:any,e:any)=>w.role!=="admin"&&Array.isArray(w.centers)&&w.centers.includes(e.center)&&disciplineFor(w.role)===e.discipline;
const publicEpisode=(row:any,metadataOnly=false)=>{const d=row.document||{};return metadataOnly?{id:row.id,center:row.center,discipline:row.discipline,level:row.level,status:row.status,created_at:row.created_at}:{...d,id:row.id,center:row.center,patient_ref:row.patient_ref,discipline:row.discipline,level:row.level,status:row.status,created_at:row.created_at};};
async function hashPassword(password:string){if(password.length<12||password.length>128)throw new Error("invalid_temporary_password");return bcrypt.hash(password,12);}
const ROLES=new Set(["nurse","physician","psychologist","physiotherapist","admin"]);
const DISCIPLINES=new Set(["nursing","psychology","physiotherapy"]);
const STATUSES=new Set(["OPEN","RESPONDIDO","CERRADO"]);
const plainObject=(v:any)=>Boolean(v&&typeof v==="object"&&!Array.isArray(v));
const nonEmpty=(v:any)=>typeof v==="string"&&v.trim().length>0;
const uniqueStrings=(v:any)=>Array.isArray(v)&&v.every(nonEmpty)&&new Set(v).size===v.length;
function validRecoverySnapshot(snapshot:any){
 if(!plainObject(snapshot)||snapshot.schema_version!==2||!["episodes","workers","audit","counters","timeclock_devices","timeclock_events","timeclock_corrections"].every(k=>Array.isArray(snapshot[k])))return false;
 const workerIds=new Set<string>(),episodeIds=new Set<string>(),counterNames=new Set<string>(),deviceIds=new Set<string>(),eventIds=new Set<string>();
 for(const x of snapshot.workers){
  if(!plainObject(x)||!nonEmpty(x.id)||workerIds.has(x.id)||!ROLES.has(x.role)||!nonEmpty(x.display_name)||typeof x.active!=="boolean"||!Number.isInteger(Number(x.auth_version))||Number(x.auth_version)<1||!uniqueStrings(x.centers)||!uniqueStrings(x.delegated_privileges)||!/^\$2[aby]\$/.test(String(x.password_hash||"")))return false;
  if(x.role==="admin"&&x.centers.length)return false;
  if(x.role!=="admin"&&!x.centers.length)return false;
  workerIds.add(x.id);
 }
 const master=snapshot.workers.find((x:any)=>x.id===MASTER());
 if(!master||master.role!=="admin"||master.active!==true)return false;
 let maxEpisodeCounter=0;
 for(const x of snapshot.episodes){
  if(!plainObject(x)||!nonEmpty(x.id)||episodeIds.has(x.id)||!nonEmpty(x.center)||!nonEmpty(x.patient_ref)||!DISCIPLINES.has(x.discipline)||![1,2,3].includes(Number(x.level))||!STATUSES.has(x.status)||!plainObject(x.document)||!x.created_at)return false;
  episodeIds.add(x.id);const m=String(x.id).match(/^GASI-EP-(\d+)$/);if(m)maxEpisodeCounter=Math.max(maxEpisodeCounter,Number(m[1]));
 }
 for(const x of snapshot.timeclock_devices){
  if(!plainObject(x)||!nonEmpty(x.id)||deviceIds.has(x.id)||!nonEmpty(x.center)||!nonEmpty(x.label)||typeof x.active!=="boolean"||!Number.isInteger(Number(x.auth_version))||Number(x.auth_version)<1||!/^([0-9a-f]{64})$/.test(String(x.token_hash||""))||!x.created_at)return false;
  deviceIds.add(x.id);
 }
 for(const x of snapshot.timeclock_events){
  if(!plainObject(x)||!nonEmpty(x.id)||eventIds.has(x.id)||!workerIds.has(String(x.worker_id))||!deviceIds.has(String(x.device_id))||!nonEmpty(x.center)||!["IN","OUT"].includes(x.event_type)||!x.occurred_at)return false;
  const device=snapshot.timeclock_devices.find((d:any)=>d.id===x.device_id);if(!device||device.center!==x.center)return false;
  eventIds.add(x.id);
 }
 for(const x of snapshot.timeclock_corrections){
  if(!plainObject(x)||!nonEmpty(x.id)||!eventIds.has(String(x.event_id))||!workerIds.has(String(x.corrected_by_id))||!nonEmpty(x.reason)||!x.corrected_at)return false;
  if(x.replacement_event_type!=null&&!["IN","OUT"].includes(x.replacement_event_type))return false;
  if(x.replacement_occurred_at!=null&&!Number.isFinite(Date.parse(String(x.replacement_occurred_at))))return false;
 }
 let previous="0".repeat(64),lastSeq=0;
 for(const x of snapshot.audit){
  if(!plainObject(x)||!Number.isInteger(Number(x.seq))||Number(x.seq)<=lastSeq||!nonEmpty(x.at)||!nonEmpty(x.actor_id)||!nonEmpty(x.actor_role)||!nonEmpty(x.action)||!(x.episode_id===null||x.episode_id===undefined||nonEmpty(x.episode_id))||!plainObject(x.metadata)||!/^([0-9a-f]{64})$/.test(String(x.previous_hash||""))||!/^([0-9a-f]{64})$/.test(String(x.event_hash||"")))return false;
  let safe;try{safe=auditMetadata(x.metadata);}catch{return false;}
  if(String(x.previous_hash)!==previous)return false;
  const payload={at:String(x.at),actor_id:String(x.actor_id),actor_role:String(x.actor_role),action:String(x.action),episode_id:x.episode_id??null,metadata:safe};
  const expected=crypto.createHash("sha256").update(previous+":"+canonical(payload)).digest("hex");
  if(expected!==String(x.event_hash))return false;
  previous=String(x.event_hash);lastSeq=Number(x.seq);
 }
 let episodeCounter:number|null=null;
 for(const x of snapshot.counters){
  if(!plainObject(x)||!nonEmpty(x.name)||counterNames.has(x.name)||!Number.isInteger(Number(x.value))||Number(x.value)<0)return false;
  counterNames.add(x.name);if(x.name==="episode")episodeCounter=Number(x.value);
 }
 if(episodeCounter===null||episodeCounter<maxEpisodeCounter)return false;
 return true;
}

async function ensureMaster(db:any){const id=MASTER();const rows=await db.sql`SELECT id FROM internal_clinical_workers WHERE id=${id} LIMIT 1`;if(rows[0])return;const configuredHash=env("GASI_MASTER_PASSWORD_HASH");const password=env("GASI_MASTER_PASSWORD");let passwordHash="";if(/^\$2[aby]\$/.test(configuredHash))passwordHash=configuredHash;else{if(password.length<12||password.length>128)throw new Error("master_bootstrap_not_configured");passwordHash=await bcrypt.hash(password,12);}const displayName=env("GASI_MASTER_DISPLAY_NAME")||"GASI Master";await db.sql`INSERT INTO internal_clinical_workers(id,role,display_name,centers,active,auth_version,delegated_privileges,password_hash) VALUES(${id},'admin',${displayName},'[]'::jsonb,TRUE,1,'[]'::jsonb,${passwordHash}) ON CONFLICT (id) DO NOTHING`;}

export default async (req:Request,_context:Context)=>{const url=new URL(req.url);const path=url.pathname;try{const connectionString=env("NETLIFY_DB_URL");const db=connectionString?getDatabase({connectionString}):getDatabase();
 if(req.method==="GET"&&path==="/api/internal-clinical/health"){await db.sql`SELECT 1`;return json({ok:true,storage:"netlify-database"});}
 if(req.method==="POST"&&path==="/api/internal-clinical/timeclock/kiosk/activate"){
  const body=await req.json() as any,deviceId=required(body.device_id,"device_id"),activationToken=required(body.activation_token,"activation_token");
  const rows=await db.sql`SELECT id,center,label,token_hash,active,auth_version FROM internal_timeclock_devices WHERE id=${deviceId} LIMIT 1`;
  const device=rows[0];if(!device||!device.active)return json({detail:"kiosk_not_found_or_revoked"},404);
  const supplied=tokenDigest(activationToken);if(supplied.length!==String(device.token_hash||"").length||!crypto.timingSafeEqual(Buffer.from(supplied),Buffer.from(String(device.token_hash||""))))return json({detail:"invalid_kiosk_activation"},403);
  const deadHash=tokenDigest(b64(crypto.randomBytes(48)));await db.sql`UPDATE internal_timeclock_devices SET token_hash=${deadHash},last_seen_at=NOW() WHERE id=${deviceId}`;
  const cookie=`${KIOSK_COOKIE}=${encodeURIComponent(signKiosk(device))}; Path=/api/internal-clinical/timeclock; HttpOnly; Secure; SameSite=Strict; Max-Age=${180*24*60*60}`;
  return json({ok:true,device:{id:device.id,center:device.center,label:device.label}},200,{"set-cookie":cookie});
 }
 if(req.method==="POST"&&path==="/api/internal-clinical/timeclock/punch"){
  let kp:any;try{kp=decodeKiosk(cookieValue(req,KIOSK_COOKIE));}catch{return json({detail:"kiosk_required"},403);}
  const devices=await db.sql`SELECT id,center,label,active,auth_version FROM internal_timeclock_devices WHERE id=${String(kp.did)} LIMIT 1`;const device=devices[0];
  if(!device||!device.active||Number(device.auth_version)!==Number(kp.av))return json({detail:"kiosk_required"},403);
  const body=await req.json() as any,workerId=required(body.worker_id,"worker_id"),password=String(body.password||"");
  const rows=await db.sql`SELECT * FROM internal_clinical_workers WHERE id=${workerId} LIMIT 1`;const worker=rows[0];
  if(!worker||!worker.active||worker.role==="admin"||!Array.isArray(worker.centers)||!worker.centers.includes(device.center)||!(await verifyPassword(password,worker.password_hash)))return json({detail:"invalid_credentials_or_center"},403);
  const lastRows=await db.sql`SELECT event_type,occurred_at FROM internal_timeclock_events WHERE worker_id=${workerId} ORDER BY occurred_at DESC LIMIT 1`;const last=lastRows[0];
  const next=last?.event_type==="IN"?"OUT":"IN",requested=String(body.event_type||next);
  if(requested!==next||!["IN","OUT"].includes(requested))return json({detail:"invalid_timeclock_transition",expected:next},409);
  const event={id:crypto.randomUUID(),worker_id:workerId,center:device.center,device_id:device.id,event_type:requested,occurred_at:new Date().toISOString()};
  await auditedMutation(db,worker,"TIMECLOCK_PUNCH",{center:device.center,device_id:device.id,event_type:requested},async client=>{
    await client.query("INSERT INTO internal_timeclock_events(id,worker_id,center,device_id,event_type,occurred_at) VALUES($1,$2,$3,$4,$5,$6)",[event.id,event.worker_id,event.center,event.device_id,event.event_type,event.occurred_at]);
    await client.query("UPDATE internal_timeclock_devices SET last_seen_at=NOW() WHERE id=$1",[device.id]);
  });
  return json({ok:true,event});
 }
 if(req.method==="POST"&&path==="/api/internal-clinical/login"){await ensureMaster(db);const body=await req.json() as any;const id=String(body.worker_id||"").trim();const rows=await db.sql`SELECT * FROM internal_clinical_workers WHERE id=${id} LIMIT 1`;const w=rows[0];if(!w||!w.active||!(await verifyPassword(String(body.password||""),w.password_hash)))return json({detail:"invalid_credentials"},401);const ttl=Math.min(480,Math.max(1,Number(env("GASI_INTERNAL_SESSION_TTL_MINUTES")||30)));const now=Math.floor(Date.now()/1000);const token=sign({sid:crypto.randomUUID(),sub:w.id,iat:now,exp:now+ttl*60,av:Number(w.auth_version)});await audit(db,w,"LOGIN_SUCCESS");return json({token,expires_at:new Date((now+ttl*60)*1000).toISOString(),profile:profile(w)});}
 const w=await actor(req,db);
 if(req.method==="GET"&&(path.endsWith("/session")||path.endsWith("/profile"))){await audit(db,w,path.endsWith("/session")?"SESSION_VALIDATED":"PROFILE_VIEWED");return json(path.endsWith("/session")?{...profile(w),active:true}:profile(w));}
 if(req.method==="POST"&&path.endsWith("/logout")){await auditedMutation(db,w,"LOGOUT_ALL_SESSIONS",{},async client=>{await client.query("UPDATE internal_clinical_workers SET auth_version=auth_version+1 WHERE id=$1",[w.id]);});return json({ok:true});}
 if(req.method==="POST"&&path==="/api/internal-clinical/password"){const b=await req.json() as any;const current=String(b.current_password||""),next=String(b.new_password||"");const rows=await db.sql`SELECT password_hash FROM internal_clinical_workers WHERE id=${w.id} LIMIT 1`;if(!rows[0]||!(await verifyPassword(current,rows[0].password_hash)))return json({detail:"invalid_current_password"},403);const password_hash=await hashPassword(next);await auditedMutation(db,w,"PASSWORD_CHANGED",{},async client=>{await client.query("UPDATE internal_clinical_workers SET password_hash=$1,auth_version=auth_version+1 WHERE id=$2",[password_hash,w.id]);});return json({ok:true,session_revoked:true});}
 if(req.method==="GET"&&path==="/api/internal-clinical/workers"){if(!has(w,"worker_access_management"))return json({detail:"worker_management_required"},403);const rows=await db.sql`SELECT id,role,display_name,centers,active,auth_version,delegated_privileges FROM internal_clinical_workers ORDER BY display_name,id`;return json(rows);}
 if(req.method==="POST"&&path==="/api/internal-clinical/timeclock/devices"){
  if(w.id!==MASTER())return json({detail:"master_account_only"},403);
  const b=await req.json() as any,center=required(b.center,"center"),label=required(b.label,"label"),id=String(b.id||`GASI-KIOSK-${crypto.randomUUID().slice(0,8).toUpperCase()}`);
  const token=b64(crypto.randomBytes(32)),hash=tokenDigest(token);
  const exists=await db.sql`SELECT id FROM internal_timeclock_devices WHERE id=${id} LIMIT 1`;if(exists.length)return json({detail:"kiosk_already_exists"},409);
  await auditedMutation(db,w,"TIMECLOCK_KIOSK_CREATED",{center,device_id:id},async client=>{await client.query("INSERT INTO internal_timeclock_devices(id,center,label,token_hash,active,auth_version) VALUES($1,$2,$3,$4,TRUE,1)",[id,center,label,hash]);});
  return json({id,center,label,activation_token:token},201);
 }
 if(req.method==="GET"&&path==="/api/internal-clinical/timeclock/devices"){
  if(w.id!==MASTER())return json({detail:"master_account_only"},403);
  const rows=await db.sql`SELECT id,center,label,active,auth_version,created_at,last_seen_at FROM internal_timeclock_devices ORDER BY center,label,id`;return json(rows);
 }
 const revokeKiosk=path.match(/^\/api\/internal-clinical\/timeclock\/devices\/([^/]+)\/revoke$/);
 if(req.method==="POST"&&revokeKiosk){
  if(w.id!==MASTER())return json({detail:"master_account_only"},403);const id=decodeURIComponent(revokeKiosk[1]);
  await auditedMutation(db,w,"TIMECLOCK_KIOSK_REVOKED",{device_id:id},async client=>{const r=await client.query("UPDATE internal_timeclock_devices SET active=FALSE,auth_version=auth_version+1 WHERE id=$1 RETURNING id",[id]);if(!r.rowCount)throw new Error("kiosk_not_found");});
  return json({ok:true});
 }
 if(req.method==="GET"&&path==="/api/internal-clinical/timeclock/me"){
  const rows=await db.sql`SELECT e.id,e.worker_id,e.center,e.device_id,e.event_type,e.occurred_at,e.created_at,(SELECT json_agg(c ORDER BY c.corrected_at) FROM internal_timeclock_corrections c WHERE c.event_id=e.id) corrections FROM internal_timeclock_events e WHERE e.worker_id=${w.id} ORDER BY e.occurred_at DESC LIMIT 500`;return json(rows);
 }
 if(req.method==="GET"&&path==="/api/internal-clinical/timeclock/events"){
  if(!has(w,"worker_access_management"))return json({detail:"worker_management_required"},403);const center=String(url.searchParams.get("center")||"");
  const rows=center?await db.sql`SELECT * FROM internal_timeclock_events WHERE center=${center} ORDER BY occurred_at DESC LIMIT 1000`:await db.sql`SELECT * FROM internal_timeclock_events ORDER BY occurred_at DESC LIMIT 1000`;return json(rows);
 }
 const correctClock=path.match(/^\/api\/internal-clinical\/timeclock\/events\/([^/]+)\/correct$/);
 if(req.method==="POST"&&correctClock){
  if(!has(w,"worker_access_management"))return json({detail:"worker_management_required"},403);const eventId=decodeURIComponent(correctClock[1]),b=await req.json() as any,reason=required(b.reason,"reason");
  const replacementType=b.replacement_event_type==null?null:String(b.replacement_event_type),replacementAt=b.replacement_occurred_at==null?null:String(b.replacement_occurred_at);
  if(replacementType!==null&&!["IN","OUT"].includes(replacementType))return json({detail:"invalid_timeclock_event_type"},422);
  if(replacementAt!==null&&!Number.isFinite(Date.parse(replacementAt)))return json({detail:"invalid_timeclock_timestamp"},422);
  const correction={id:crypto.randomUUID(),event_id:eventId,replacement_event_type:replacementType,replacement_occurred_at:replacementAt,reason,corrected_by_id:w.id};
  await auditedMutation(db,w,"TIMECLOCK_CORRECTED",{event_id:eventId},async client=>{const exists=await client.query("SELECT id FROM internal_timeclock_events WHERE id=$1",[eventId]);if(!exists.rowCount)throw new Error("timeclock_event_not_found");await client.query("INSERT INTO internal_timeclock_corrections(id,event_id,replacement_event_type,replacement_occurred_at,reason,corrected_by_id) VALUES($1,$2,$3,$4,$5,$6)",[correction.id,eventId,replacementType,replacementAt,reason,w.id]);});
