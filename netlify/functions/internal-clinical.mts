function contingencyTarget(type:string,value:unknown){const target=required(value,"contingency_target",500);if(type==="PHONE"){if(!/^[+0-9().\s-]{5,40}$/.test(target))throw new Error("invalid_contingency_target");return target;}if(type==="URL"){let parsed:URL;try{parsed=new URL(target);}catch{throw new Error("invalid_contingency_target");}if(parsed.protocol!=="https:"||parsed.username||parsed.password)throw new Error("invalid_contingency_target");return parsed.toString();}if(type==="REFERENCE")return target;throw new Error("invalid_contingency_type");}
const RECOVERY_ROLES=new Set(["nurse","physician","psychologist","physiotherapist","admin"]),RECOVERY_DISCIPLINES=new Set(["nursing","psychology","physiotherapy"]),RECOVERY_EPISODE_STATUSES=new Set(["ABIERTO","RESPONDIDO","CERRADO"]),BCRYPT_HASH=/^\$2[aby]\$\d{2}\$[./A-Za-z0-9]{53}$/;
const required=(v:unknown,name:string,max=160)=>{const s=String(v||"").trim();if(!s)throw new Error(`${name}_required`);if(s.length>max)throw new Error(`${name}_too_long`);return s;};
const boundedLimit=(raw:string|null,fallback:number,max:number)=>{const n=Number(raw);return Number.isSafeInteger(n)&&n>0?Math.min(max,n):fallback;};
const positiveSeq=(raw:string|null)=>{if(raw==null||raw==="")return null;const n=Number(raw);return Number.isSafeInteger(n)&&n>0?n:null;};
const sessionTtlMinutes=()=>{const n=Number(env("GASI_INTERNAL_SESSION_TTL_MINUTES"));return Number.isSafeInteger(n)&&n>=1&&n<=480?n:30;};
function secret(){const value=env("GASI_INTERNAL_SESSION_SECRET");if(Buffer.byteLength(value)<32)throw new Error("session_secret_not_configured");return value;}
function recoverySecret(){const value=env("GASI_RECOVERY_SIGNING_SECRET");if(Buffer.byteLength(value)<32)throw new Error("recovery_signing_secret_not_configured");return value;}
function sign(payload:any){const encoded=b64(JSON.stringify(payload));const sig=crypto.createHmac("sha256",secret()).update(encoded).digest("base64url");return `v1.${encoded}.${sig}`;}
function decode(token:string){const parts=token.split(".");if(parts.length!==3)throw new Error("invalid_session_token");const[version,encoded,supplied]=parts;if(version!=="v1"||!encoded||!supplied)throw new Error("invalid_session_token");const expected=crypto.createHmac("sha256",secret()).update(encoded).digest("base64url");if(expected.length!==supplied.length||!crypto.timingSafeEqual(Buffer.from(expected),Buffer.from(supplied)))throw new Error("invalid_session_token");let p:any;try{p=JSON.parse(Buffer.from(encoded,"base64url").toString("utf8"));}catch{throw new Error("invalid_session_token");}if(typeof p.sub!=="string"||!p.sub||typeof p.sid!=="string"||!p.sid||!Number.isSafeInteger(Number(p.iat))||!Number.isSafeInteger(Number(p.exp))||!Number.isSafeInteger(Number(p.av))||Number(p.av)<1||Number(p.exp)<=Number(p.iat)||Date.now()>=Number(p.exp)*1000)throw new Error("session_expired_or_revoked");return p;}
async function actor(req:Request,db:any){const token=bearer(req);if(!token)throw new Error("missing_session");const p=decode(token);const rows=await db.sql`SELECT id,tenant_id,role,display_name,centers,active,auth_version,delegated_privileges,must_change_password FROM internal_clinical_workers WHERE id=${String(p.sub)} LIMIT 1`;const w=rows[0];if(!w||!w.active||Number(w.auth_version)!==Number(p.av))throw new Error("session_expired_or_revoked");return w;}
const FORBIDDEN_AUDIT_KEYS=new Set(["patient_ref","patientref","summary","text","replacement_text","previous_text","password","password_hash","token","authorization","clinical_note","note","diagnosis","symptoms"]);
function auditMetadata(metadata:any){const out:any={};for(const [raw,value] of Object.entries(metadata||{})){const key=String(raw).trim();if(!key||FORBIDDEN_AUDIT_KEYS.has(key.toLowerCase())||value!==null&&!["string","number","boolean"].includes(typeof value))throw new Error("audit_metadata_forbidden");out[key]=value;}return out;}
function canonical(value:any):string{if(value===null||typeof value!=="object")return JSON.stringify(value);if(Array.isArray(value))return "["+value.map(canonical).join(",")+"]";return "{"+Object.keys(value).sort().map(k=>JSON.stringify(k)+":"+canonical(value[k])).join(",")+"}";}
function recoverySnapshotSignature(payload:any){return crypto.createHmac("sha256",recoverySecret()).update(canonical(payload)).digest("hex");}
function validAuditSnapshot(rows:any[]){const ordered=[...rows].sort((a:any,b:any)=>Number(a.seq)-Number(b.seq));let previous="0".repeat(64);for(const x of ordered){if(String(x.previous_hash||"")!==previous)return false;const payload={at:String(x.at),actor_id:String(x.actor_id),actor_role:String(x.actor_role),action:String(x.action),episode_id:x.episode_id==null?null:String(x.episode_id),metadata:x.metadata||{}};const expected=crypto.createHash("sha256").update(previous+":"+canonical(payload)).digest("hex");if(String(x.event_hash||"")!==expected)return false;previous=expected;}return true;}function validAttendanceSnapshot(rows:any[]){const ordered=[...rows].sort((a:any,b:any)=>Number(a.seq)-Number(b.seq)),originals=ordered.filter((x:any)=>["CLOCK_IN","CLOCK_OUT"].includes(String(x.event_type))),originalBySeq=new Map(originals.map((x:any)=>[Number(x.seq),x])),latestCorrection=new Map<number,any>();for(const x of ordered){if(String(x.event_type)!=="CORRECTION")continue;const related=Number(x.related_event_seq),original:any=originalBySeq.get(related),type=String(x.metadata?.corrected_event_type||""),at=String(x.metadata?.corrected_occurred_at||"");if(!original||!["CLOCK_IN","CLOCK_OUT"].includes(type)||!Number.isFinite(Date.parse(at)))return false;const prior=latestCorrection.get(related);if(!prior||Number(x.seq)>Number(prior.seq))latestCorrection.set(related,x);}const byWorker=new Map<string,any[]>();for(const original of originals){const worker=String(original.worker_id),correction=latestCorrection.get(Number(original.seq)),effective={type:correction?String(correction.metadata.corrected_event_type):String(original.event_type),at:correction?String(correction.metadata.corrected_occurred_at):String(original.occurred_at),seq:Number(original.seq)};if(!Number.isFinite(Date.parse(effective.at)))return false;byWorker.set(worker,[...(byWorker.get(worker)||[]),effective]);}for(const events of byWorker.values()){events.sort((a:any,b:any)=>a.seq-b.seq);for(let i=0;i<events.length;i++){if(events[i].type!==(i%2===0?"CLOCK_IN":"CLOCK_OUT"))return false;if(i>0&&Date.parse(events[i].at)<Date.parse(events[i-1].at))return false;}}return true;}

async function auditOnClient(client:any,w:any,action:string,metadata:any={}){await client.query("SELECT pg_advisory_xact_lock($1)",[74627411]);const last=await client.query("SELECT event_hash FROM internal_clinical_audit ORDER BY seq DESC LIMIT 1");const previous=last.rows[0]?.event_hash||"0".repeat(64);const at=new Date().toISOString();const safe=auditMetadata({...metadata,actor_tenant_id:String(w.tenant_id||"")});const payload={at,actor_id:w.id,actor_role:w.role,action,episode_id:typeof safe.episode_id==="string"?safe.episode_id:null,metadata:safe};const hash=crypto.createHash("sha256").update(previous+":"+canonical(payload)).digest("hex");await client.query("INSERT INTO internal_clinical_audit(at,actor_id,actor_role,action,episode_id,metadata,previous_hash,event_hash) VALUES($1,$2,$3,$4,$5,$6,$7,$8)",[at,w.id,w.role,action,payload.episode_id,safe,previous,hash]);}
async function audit(db:any,w:any,action:string,metadata:any={}){const client=await db.pool.connect();try{await client.query("BEGIN");await auditOnClient(client,w,action,metadata);await client.query("COMMIT");}catch(e){await client.query("ROLLBACK");throw e;}finally{client.release();}}
async function verifyPassword(password:string,stored:string){if(!/^\$2[aby]\$/.test(stored))return false;return bcrypt.compare(password,stored);}
function loginSource(req:Request){const edge=(req.headers.get("x-nf-client-connection-ip")||"").trim(),forwarded=(req.headers.get("x-forwarded-for")||"").split(",")[0].trim();return edge||forwarded||"unknown";}
function loginHash(raw:string){return crypto.createHash("sha256").update(raw).digest("hex");}
function loginBuckets(req:Request,id:string){const source=loginSource(req);return[{key:loginHash(`pair:${source}:${id}`),limit:8,scope:"pair"},{key:loginHash(`ip:${source}`),limit:40,scope:"ip"}];}
async function pruneLoginThrottle(db:any){await db.sql`DELETE FROM internal_login_throttle WHERE updated_at < NOW() - INTERVAL '1 day'`;}
async function loginLimited(db:any,buckets:any[]){for(const bucket of buckets){const rows=await db.sql`SELECT failures,window_started_at,blocked_until FROM internal_login_throttle WHERE key_hash=${bucket.key} LIMIT 1`,v=rows[0];if(!v)continue;const now=Date.now(),blockedUntil=Date.parse(String(v.blocked_until||"")),started=Date.parse(String(v.window_started_at||""));if(Number.isFinite(blockedUntil)&&blockedUntil>now)return true;if(!Number.isFinite(started)||now-started>=15*60_000){await db.sql`DELETE FROM internal_login_throttle WHERE key_hash=${bucket.key}`;continue;}if(Number(v.failures)>=Number(bucket.limit))return true;}return false;}
async function loginFailed(db:any,buckets:any[]){const ordered=[...buckets].sort((a,b)=>String(a.key).localeCompare(String(b.key))),client=await db.pool.connect();try{await client.query("BEGIN");for(const bucket of ordered)await client.query("SELECT pg_advisory_xact_lock(hashtext($1))",[bucket.key]);for(const bucket of buckets){const q=await client.query("SELECT failures,window_started_at FROM internal_login_throttle WHERE key_hash=$1 LIMIT 1",[bucket.key]),now=Date.now(),v=q.rows[0],started=v?Date.parse(String(v.window_started_at||"")):NaN;if(!v||!Number.isFinite(started)||now-started>=15*60_000){await client.query("INSERT INTO internal_login_throttle(key_hash,failures,window_started_at,blocked_until,updated_at) VALUES($1,1,NOW(),NULL,NOW()) ON CONFLICT (key_hash) DO UPDATE SET failures=1,window_started_at=NOW(),blocked_until=NULL,updated_at=NOW()",[bucket.key]);}else{const next=Number(v.failures)+1,blockedUntil=next>=Number(bucket.limit)?new Date(now+15*60_000):null;await client.query("UPDATE internal_login_throttle SET failures=$2,blocked_until=$3,updated_at=NOW() WHERE key_hash=$1",[bucket.key,next,blockedUntil]);}}await client.query("COMMIT");}catch(e){await client.query("ROLLBACK");throw e;}finally{client.release();}}
async function loginSucceeded(db:any,buckets:any[]){const pair=buckets.find((x:any)=>x.scope==="pair");if(pair)await db.sql`DELETE FROM internal_login_throttle WHERE key_hash=${pair.key}`;}
const disciplineFor=(role:string)=>role==="psychologist"?"psychology":role==="physiotherapist"?"physiotherapy":"nursing";
async function writableEpisodeOnClient(client:any,w:any,id:string,lock=false){if(w.role==="admin")return null;const centers=Array.isArray(w.centers)?w.centers:[],tenantId=String(w.tenant_id||"");if(!tenantId||!centers.length)return null;const sql=lock?"SELECT * FROM internal_clinical_episodes WHERE id=$1 AND tenant_id=$2 AND center = ANY($3::text[]) AND discipline=$4 LIMIT 1 FOR UPDATE":"SELECT * FROM internal_clinical_episodes WHERE id=$1 AND tenant_id=$2 AND center = ANY($3::text[]) AND discipline=$4 LIMIT 1";const result=await client.query(sql,[id,tenantId,centers,disciplineFor(w.role)]);return result.rows[0]||null;}
